# Raw PISA SPSS files are too large for GitHub (1-13 GB each): download them from the OECD (see data/README.md)
data/raw/*
!data/raw/.gitkeep
*.sav
*.zip
# Processed PISA 2025 public-use extracts in data/processed/ ARE committed (each file < 100 MB) for Colab
# Manuscript is kept outside the repository
manuscript/
# Credentials
.env
*.token
*credentials*
# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
results/checkpoints/
*.egg-info/

# LaTeX build artefacts
manuscript/*.aux
manuscript/*.bbl
manuscript/*.blg
manuscript/*.fdb_latexmk
manuscript/*.fls
manuscript/*.log
manuscript/*.out
# Markdown documents (reports, notes) are kept outside the repository; only the global README is committed
*.md
!/README.md
